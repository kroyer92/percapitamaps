      ],
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/channels?part=id&mine=true",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "c57238d4-6be6-50b2-03d7-2d1ea319a8b7",
      "name": "Recent comment threads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        80
      ],
      "parameters": {
        "url": "=https://www.googleapis.com/youtube/v3/commentThreads?part=snippet,replies&allThreadsRelatedToChannelId={{ $json.items[0].id }}&maxResults=100&order=time&textFormat=plainText",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "1521623a-ac67-ed2c-35cf-32472d3d716f",
      "name": "Threads with more replies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        80
      ],
      "parameters": {
        "jsCode": "const threads = $('Recent comment threads').first().json.items ?? [];\nconst busy = threads.filter((t) => (t.snippet.totalReplyCount ?? 0) > (t.replies?.comments?.length ?? 0)).slice(0, 20);\nreturn busy.length ? busy.map((t) => ({ json: { parent_id: t.id } })) : [{ json: { parent_id: '' } }];"
      }
    },
    {
      "id": "f028b092-e147-dc44-77f0-0afdffe0dfe4",
      "name": "Any?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "4e05405f-6b17-0d0d-b7b2-38f6b18184bb",
              "leftValue": "={{ $json.parent_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "facd483d-914e-42b5-14c9-4006adfbf623",
      "name": "All replies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "url": "=https://www.googleapis.com/youtube/v3/comments?part=snippet&parentId={{ $json.parent_id }}&maxResults=100&textFormat=plainText",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "2a8daa04-8dff-5f9d-f53c-7e6163b4a78b",
      "name": "Bundle comments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        80
      ],
      "parameters": {
        "jsCode": "const replies = $input.all().flatMap((i) => i.json.kind === 'youtube#commentListResponse' ? i.json.items ?? [] : []);\nreturn [{ json: { channel_id: $('My channel').first().json.items?.[0]?.id ?? '', threads: $('Recent comment threads').first().json.items ?? [], replies } }];"
      }
    },
    {
      "id": "82f77277-3962-3204-c70d-2df74f314a8a",
      "name": "Draft replies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "http://render-worker:8080/comments/youtube",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
